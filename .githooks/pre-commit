#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"
if [[ -z "${staged_files//[$'\t\r\n ']}" ]]; then
  exit 0
fi

if [[ ! -x ".venv/bin/python" ]]; then
  echo "Missing .venv/bin/python. Create the virtual environment before commit." >&2
  exit 1
fi

if ! command -v uv >/dev/null 2>&1; then
  echo "uv is required for pre-commit checks but was not found." >&2
  exit 1
fi

run_uv() {
  UV_CACHE_DIR=.uv-cache uv run --python .venv/bin/python "$@"
}

staged_py_files=()
while IFS= read -r path; do
  [[ -z "$path" ]] && continue
  if [[ "$path" == *.py ]] && [[ -f "$path" ]]; then
    staged_py_files+=("$path")
  fi
done <<< "$staged_files"

if (( ${#staged_py_files[@]} > 0 )); then
  echo "Running ruff format/check on staged Python files ..."
  run_uv ruff format "${staged_py_files[@]}"
  run_uv ruff check --fix "${staged_py_files[@]}"
  git add "${staged_py_files[@]}"
fi

echo "Running repo-wide Ruff checks ..."
run_uv ruff check

echo "Running full test suite ..."
run_uv python -m unittest discover -s tests -v

# Run lint-report generation only when lint-relevant files are staged.
if ! printf '%s\n' "$staged_files" | grep -E -q '^(out/.*\.tsv|linter/|scripts/(generate_lint_reports|parse_lint_reports|install_git_hooks|run_tablet_parsing_pipeline)\.py|lint_reports/|pipeline/|reports/|\.github/workflows/morphology-lint\.yml)'; then
  exit 0
fi

echo "Generating morphology lint reports under reports/ ..."
run_uv python scripts/generate_lint_reports.py

git add reports/
