#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"
if [[ -z "${staged_files//[$'\t\r\n ']}" ]]; then
  exit 0
fi

if [[ ! -x ".venv/bin/python" ]]; then
  echo "Missing .venv/bin/python. Create the virtual environment before commit." >&2
  exit 1
fi

py_mm="$(".venv/bin/python" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')"
if [[ "$py_mm" != "3.13" ]]; then
  echo "Expected .venv Python 3.13, found $py_mm. Recreate .venv with Python 3.13." >&2
  exit 1
fi

use_uv_run=false
if command -v uv >/dev/null 2>&1; then
  if UV_CACHE_DIR=.uv-cache uv run --python .venv/bin/python python -c "import sys; sys.exit(0)" >/dev/null 2>&1; then
    use_uv_run=true
  else
    echo "uv run is unavailable; falling back to direct .venv execution." >&2
  fi
fi

run_python() {
  if [[ "$use_uv_run" == "true" ]]; then
    UV_CACHE_DIR=.uv-cache uv run --python .venv/bin/python python "$@"
    return
  fi
  ".venv/bin/python" "$@"
}

run_ruff() {
  if [[ "$use_uv_run" == "true" ]]; then
    UV_CACHE_DIR=.uv-cache uv run --python .venv/bin/python ruff "$@"
    return
  fi

  if [[ -x ".venv/bin/ruff" ]]; then
    ".venv/bin/ruff" "$@"
    return
  fi

  if command -v ruff >/dev/null 2>&1; then
    ruff "$@"
    return
  fi

  run_python -m ruff "$@"
}

staged_py_files=()
while IFS= read -r path; do
  [[ -z "$path" ]] && continue
  if [[ "$path" == *.py ]] && [[ -f "$path" ]]; then
    staged_py_files+=("$path")
  fi
done <<< "$staged_files"

if (( ${#staged_py_files[@]} > 0 )); then
  echo "Running ruff format/check on staged Python files ..."
  run_ruff format "${staged_py_files[@]}"
  run_ruff check --fix "${staged_py_files[@]}"
  run_ruff check "${staged_py_files[@]}"
  git add "${staged_py_files[@]}"
fi

echo "Running full test suite ..."
run_python -m unittest discover -s tests -v

# Run lint-report generation only when lint-relevant files are staged.
if ! printf '%s\n' "$staged_files" | grep -E -q '^(out/.*\.tsv|linter/|scripts/(generate_lint_reports|parse_lint_reports|install_git_hooks|run_tablet_parsing_pipeline)\.py|lint_reports/|pipeline/|reports/|\.github/workflows/morphology-lint\.yml)'; then
  exit 0
fi

echo "Generating morphology lint reports under reports/ ..."
run_python scripts/generate_lint_reports.py

git add reports/
